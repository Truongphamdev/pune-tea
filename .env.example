# Sao chép thành .env.local nếu cần đổi. Mọi biến đều KHÔNG bắt buộc — để trống thì dùng mặc định.

# URL gốc tuyệt đối của site, dùng cho canonical, sitemap, Open Graph (BA SEO-08).
# Mặc định: http://localhost:3010
NEXT_PUBLIC_SITE_URL=

# Link Facebook page nhận đơn (BA §7.6). Phải là https.
# Mặc định: https://www.facebook.com/share/19fniaMu8F/?mibextid=wwXIfr
NEXT_PUBLIC_FACEBOOK_PAGE_URL=

# Database (tài khoản, đơn hàng). Chạy máy cá nhân: để trống → file SQLite storage/puni-tea.db, tự tạo.
# Deploy Vercel: URL Turso dạng libsql://ten-db-ten-tai-khoan.turso.io và token của nó.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
